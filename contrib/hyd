#!/usr/bin/env bash
# hyd - query a hydd read-only PTR mirror.
#
#   hyd [--sha256|--sha1|--md5] FILE   hash FILE and query its tags
#   hyd HASH                           query a SHA-256, SHA-1, or MD5 hash
#   hyd stats|scan|repair|verify|version
#   hyd counts TAG...                  mapping count per tag from the running API
#   hyd hashes TAG [OFFSET] [LIMIT]    paged SHA-256 list for one tag (reverse index)
#   hyd rebuild-counts                 rebuild counts.bin and tag_lookup.bin
#   hyd check                          verify the store and the derived counts
#
# Set HYD_BIN or HYD_CONFIG to override the defaults.

set -u

HYD_BIN=${HYD_BIN:-hydd}
HYD_CONFIG=${HYD_CONFIG:-/etc/hydd.conf}

usage()
{
    cat <<'EOF'
usage: hyd [--sha256|--sha1|--md5] FILE|HASH
       hyd stats
       hyd counts TAG...
       hyd hashes TAG [OFFSET] [LIMIT]
       hyd rebuild-counts
       hyd check
       hyd scan
       hyd repair
       hyd verify
       hyd version

Arguments:
  FILE       Hash the file (SHA-256 by default) and query it.
  HASH       Query a 64-character SHA-256, 40-character SHA-1, or
             32-character MD5 hash directly.

Options:
  --sha256   Hash FILE with SHA-256 (default).
  --sha1     Hash FILE with SHA-1.
  --md5      Hash FILE with MD5.
  -h, --help Show usage.

Environment:
  HYD_BIN     hydd executable (default: hydd)
  HYD_CONFIG  config file (default: /etc/hydd.conf)

The query commands use the local API, so the daemon must be running.
Loopback requests are trusted by default. If the daemon sets
require_localhost_key = true, run as the hyd user or set HYDD_API_KEY.
EOF
}

fail()
{
    printf 'hyd: %s\n' "$*" >&2
    exit 1
}

require_bin()
{
    command -v "$HYD_BIN" >/dev/null 2>&1 || fail "cannot find $HYD_BIN (set HYD_BIN)"
}

hash_file()
{
    algo=$1
    file=$2

    [ -f "$file" ] || fail "not a file: $file"

    case "$file" in
        -*) file="./$file" ;;
    esac

    case "$algo" in
        sha256)
            if command -v sha256sum >/dev/null 2>&1; then
                sha256sum "$file" | awk '{print $1}'
            elif command -v shasum >/dev/null 2>&1; then
                shasum -a 256 "$file" | awk '{print $1}'
            elif command -v openssl >/dev/null 2>&1; then
                openssl dgst -sha256 < "$file" | awk '{print $NF}'
            else
                fail "no SHA-256 tool found (need sha256sum, shasum, or openssl)"
            fi
            ;;
        sha1)
            if command -v sha1sum >/dev/null 2>&1; then
                sha1sum "$file" | awk '{print $1}'
            elif command -v shasum >/dev/null 2>&1; then
                shasum -a 1 "$file" | awk '{print $1}'
            elif command -v openssl >/dev/null 2>&1; then
                openssl dgst -sha1 < "$file" | awk '{print $NF}'
            else
                fail "no SHA-1 tool found (need sha1sum, shasum, or openssl)"
            fi
            ;;
        md5)
            if command -v md5sum >/dev/null 2>&1; then
                md5sum "$file" | awk '{print $1}'
            elif command -v md5 >/dev/null 2>&1; then
                md5 -q "$file"
            elif command -v openssl >/dev/null 2>&1; then
                openssl dgst -md5 < "$file" | awk '{print $NF}'
            else
                fail "no MD5 tool found (need md5sum, md5, or openssl)"
            fi
            ;;
        *)
            fail "unknown hash algorithm: $algo"
            ;;
    esac
}

is_hex()
{
    case "$1" in
        *[!0-9a-fA-F]*) return 1 ;;
    esac
    return 0
}

is_hash()
{
    length=${#1}
    if [ "$length" -ne 64 ] && [ "$length" -ne 40 ] && [ "$length" -ne 32 ]; then
        return 1
    fi
    is_hex "$1"
}

cmd_stats()
{
    require_bin
    "$HYD_BIN" -c "$HYD_CONFIG" --stats
}

cmd_counts()
{
    require_bin
    [ "$#" -gt 0 ] || fail "no tag given"
    status=0
    for tag in "$@"; do
        if ! "$HYD_BIN" -c "$HYD_CONFIG" --tag-counts "$tag"; then
            status=1
        fi
    done
    return "$status"
}

# run_privileged CMD...: run as the current user, and retry through doas/sudo
# only when the first failure looks like a permissions or daemon-lock problem.
# This keeps `hyd rebuild-counts` usable on a local install (user-owned data
# dir) without asking for a password, while working on the packaged system
# service (root-owned /var/lib/hyd).
run_privileged()
{
    output=$("$@" 2>&1)
    rc=$?
    if [ "$rc" -eq 0 ]; then
        [ -z "$output" ] || printf '%s\n' "$output"
        return 0
    fi

    case "$output" in
        *"Permission denied"*|*"cannot open"*|*"cannot create"*|*"cannot chmod"*|*"another hydd process"*)
            if [ "$(id -u)" -eq 0 ]; then
                printf '%s\n' "$output" >&2
                return "$rc"
            fi
            printf 'hyd: retrying with elevated privileges\n' >&2
            if command -v doas >/dev/null 2>&1; then
                doas "$@"
            elif command -v sudo >/dev/null 2>&1; then
                sudo "$@"
            else
                printf '%s\n' "$output" >&2
                fail "need root (or the hyd user); install doas or sudo, or run it yourself"
            fi
            ;;
        *)
            [ -z "$output" ] || printf '%s\n' "$output" >&2
            return "$rc"
            ;;
    esac
}

cmd_rebuild_counts()
{
    require_bin
    run_privileged "$HYD_BIN" -c "$HYD_CONFIG" --rebuild-tag-counts
}

cmd_hashes()
{
    require_bin
    [ "$#" -gt 0 ] || fail "no tag given"
    tag=$1
    shift
    offset=${1:-0}
    [ "$#" -eq 0 ] || shift
    limit=${1:-100}
    [ "$#" -eq 0 ] || shift
    [ "$#" -eq 0 ] || fail "usage: hyd hashes TAG [OFFSET] [LIMIT]"
    "$HYD_BIN" -c "$HYD_CONFIG" --tag-hashes "$tag" \
        --hash-offset "$offset" --hash-limit "$limit"
}

cmd_check()
{
    require_bin
    run_privileged "$HYD_BIN" -c "$HYD_CONFIG" --verify-store || return 1
    run_privileged "$HYD_BIN" -c "$HYD_CONFIG" --check-tag-counts
}

cmd_scan()
{
    require_bin
    if ! "$HYD_BIN" -c "$HYD_CONFIG" --scan-updates; then
        printf 'hyd: hint: the update cache may need read access; try sudo -u hyd\n' >&2
        exit 1
    fi
}

cmd_verify()
{
    require_bin
    if ! "$HYD_BIN" -c "$HYD_CONFIG" --verify-store; then
        printf 'hyd: hint: the store may need read access; try sudo -u hyd\n' >&2
        exit 1
    fi
}

cmd_repair()
{
    require_bin
    if ! "$HYD_BIN" -c "$HYD_CONFIG" --repair-cache; then
        printf 'hyd: hint: the update cache may need write access; try sudo -u hyd\n' >&2
        exit 1
    fi
}

cmd_version()
{
    require_bin
    version_output=$("$HYD_BIN" --version)
    case "$version_output" in
        hyd\ v*) printf '%s\n' "$version_output" ;;
        hydd\ *) printf 'hyd v%s\n' "${version_output#hydd }" ;;
        hyd\ *) printf 'hyd v%s\n' "${version_output#hyd }" ;;
        *) printf 'hyd v%s\n' "$version_output" ;;
    esac
}

if [ "$#" -eq 0 ]; then
    usage
    exit 1
fi

case "$1" in
    stats)
        cmd_stats
        exit 0
        ;;
    counts)
        shift
        cmd_counts "$@"
        exit $?
        ;;
    hashes)
        shift
        cmd_hashes "$@"
        exit $?
        ;;
    rebuild-counts)
        cmd_rebuild_counts
        exit $?
        ;;
    check)
        cmd_check
        exit $?
        ;;
    scan)
        cmd_scan
        exit 0
        ;;
    repair)
        cmd_repair
        exit 0
        ;;
    verify)
        cmd_verify
        exit 0
        ;;
    version|--version|-V)
        cmd_version
        exit 0
        ;;
    help|-h|--help)
        usage
        exit 0
        ;;
esac

algo=sha256
argument=

while [ "$#" -gt 0 ]; do
    case "$1" in
        --sha256)
            algo=sha256
            ;;
        --sha1)
            algo=sha1
            ;;
        --md5)
            algo=md5
            ;;
        -*)
            fail "unknown option: $1"
            ;;
        *)
            [ -z "$argument" ] || fail "only one file or hash is supported"
            argument=$1
            ;;
    esac
    shift
done

[ -n "$argument" ] || fail "no file or hash given"

if is_hash "$argument"; then
    if [ -f "$argument" ]; then
        fail "ambiguous argument: '$argument' is both a hash and an existing file; use ./$argument for the file"
    fi
    target_hash=$argument
    header=
elif [ -f "$argument" ]; then
    target_hash=$(hash_file "$algo" "$argument") || exit 1
    header="# $argument ($algo $target_hash)"
else
    fail "not a file or a SHA-256, SHA-1, or MD5 hash: $argument"
fi

require_bin

if [ -n "$header" ]; then
    printf '%s\n' "$header"
fi

"$HYD_BIN" -c "$HYD_CONFIG" --api-query "$target_hash"
